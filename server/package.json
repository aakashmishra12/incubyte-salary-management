{
  "name": "@salary/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "NODE_ENV=production node src/index.ts",
    "seed": "node src/seed/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "measure": "node src/measure.ts",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-sqlite3": "13.2.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "vitest": "5.1.1"
  }
}
