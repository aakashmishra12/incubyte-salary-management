# Copy this file to .env and fill in what you have. .env is ignored by git and must never be committed.
# Everything here is optional. With no provider key the assistant is switched off, and nothing else changes.

# --- Pay assistant: providers ---------------------------------------------------------------
# A provider is on only if its key is set. They are tried in this order, and the next one is used
# when one is rate limited or down. Model names change: check each provider's current list.
#ASSISTANT_PROVIDERS=groq,gemini,openrouter,nvidia,ollama

# Google AI Studio (free tier: about 20 requests a day on the main Flash models). Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
#GEMINI_MODEL=gemini-3.5-flash
#GEMINI_DAILY_LIMIT=18

# Groq (free tier). Key from https://console.groq.com/keys
GROQ_API_KEY=
#GROQ_MODEL=openai/gpt-oss-120b   # checked with a live key
#GROQ_DAILY_LIMIT=500

# NVIDIA (free access for trying things out, about 40 requests a minute). Key from https://build.nvidia.com
NVIDIA_API_KEY=
#NVIDIA_MODEL=nvidia/nemotron-3-super-120b
#NVIDIA_DAILY_LIMIT=200

# OpenRouter (free models: 50 requests a day, 1000 after buying credits). Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
#OPENROUTER_MODEL=openrouter/free
#OPENROUTER_DAILY_LIMIT=45

# A local model through Ollama needs no key. Set the model name to turn it on.
#OLLAMA_MODEL=qwen2.5:7b

# --- Pay assistant: limits ------------------------------------------------------------------
#ASSISTANT_PER_VISITOR_PER_HOUR=20
#ASSISTANT_PER_DAY=300

# --- Server ---------------------------------------------------------------------------------
#PORT=3000
#DATABASE_FILE=server/data/salary.sqlite
# How many web servers sit in front of this app (1 for Apache or nginx). Needed to tell visitors
# apart for the question limits. Leave unset if the app is reached directly.
#TRUST_PROXY=1
